# SAMUDRA-3D Environment Configuration Template (SIH26067)
# Team Nexus Nova - Ministry of Earth Sciences (MoES) / INCOIS

# Backend Service Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:80

# Real Ocean Dataset Root (External directory containing real GLORYS / Argo / In-situ NetCDFs)
# If omitted or unmounted, the application gracefully falls back to synthetic test data.
SAMUDRA_DATA_ROOT=D:\Studies\SIH\Samudra 3D\SAMUDRA_DATA

# Synthetic / Operational NetCDF Datasets (Fallback fixtures)
ROMS_DATASET_PATH=backend/sample_data/model_indian_ocean.nc
ARGO_DATA_DIR=backend/sample_data
GLIDER_DATA_DIR=backend/sample_data

# In-Situ / ERDDAP Endpoints (for Live Operational Stream Integration)
INCOIS_ERDDAP_URL=https://erddap.incois.gov.in/erddap/tabledap/
ARGO_GDAC_URL=https://data-argo.ifremer.fr/

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api
