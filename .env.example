# SAMUDRA-3D Environment Configuration Template
# Smart India Hackathon 2026 - Problem Statement SIH26067
# Ministry of Earth Sciences (MoES) / INCOIS

# PostgreSQL Database Configuration
DATABASE_URL=postgresql+psycopg://samudra:samudra@localhost:5432/samudra
POSTGRES_DB=samudra
POSTGRES_USER=samudra
POSTGRES_PASSWORD=samudra

# Scientific Ocean Data Root Directory
SAMUDRA_DATA_ROOT=./SAMUDRA_DATA

# Institutional Security & Initial Provisioning
SAMUDRA_ADMIN_USERNAME=admin
SAMUDRA_ADMIN_PASSWORD=Samudra#Admin2026!

# Network & CORS Origins
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4175,http://127.0.0.1:4175,https://samudra-3dd.vercel.app
